{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tsunagi/ds2-core": [
        "./packages/ds2-core/src/index.ts"
      ],
      "@tsunagi/ds2-core/*": [
        "./packages/ds2-core/src/*"
      ],
      "@tsunagi/ds2-smg2": [
        "./packages/ds2-smg2/src/index.ts"
      ],
      "@tsunagi/ds2-smg2/*": [
        "./packages/ds2-smg2/src/*"
      ],
      "@tsunagi/c166": [
        "./packages/c166/src/index.ts"
      ],
      "@tsunagi/c166/*": [
        "./packages/c166/src/*"
      ],
      "@tsunagi/ds2-smg2-write": [
        "./packages/ds2-smg2-write/src/index.ts"
      ],
      "@tsunagi/ds2-smg2-write/*": [
        "./packages/ds2-smg2-write/src/*"
      ],
      "@tsunagi/xdf-engine": [
        "./packages/xdf-engine/src/index.ts"
      ],
      "@tsunagi/xdf-engine/*": [
        "./packages/xdf-engine/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "types/workers-webcrypto.d.ts"
  ]
}
